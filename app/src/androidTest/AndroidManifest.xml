<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A Storage Access Framework provider with documents of every kind of capability, for the external-file tests. Only the test
             process hands out URIs to it (with or without write grants), exactly like a file manager's "Open with". -->
        <provider
            android:name="io.github.zeperus.openpad.TestDocumentsProvider"
            android:authorities="io.github.zeperus.openpad.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- Stands in for another app's "Open with": it belongs to the test package, which owns the provider, so the grants it hands to
             openPad++ are real (the code of the tests themselves runs with openPad++'s identity and could not give any). -->
        <activity
            android:name="io.github.zeperus.openpad.OpenWithActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
